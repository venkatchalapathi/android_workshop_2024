<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bug Tracker</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <main class="container">
        <h1 class="heading">Bug Tracker</h1>
        <div id="bug-list" class="bug-list">
            <!-- Bug cards will be inserted here by JavaScript -->
        </div>
        <button id="preview-button" class="preview-button" style="display: none;">Preview</button>
    </main>

    <template id="bug-card-template">
        <div class="bug-card">
            <div class="bug-card-header">
                <h2 class="bug-title"></h2>
                <span class="bug-id"></span>
            </div>
            <p class="bug-assignee"></p>
            <p class="bug-created-date"></p>
            <div class="bug-card-details" style="display: none;">
                <form class="bug-card-form">
                    <div class="form-group">
                        <label for="comment">Comment</label>
                        <textarea class="input-field" id="comment" placeholder="Enter comment"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="component">Component</label>
                        <select class="input-field" id="component">
                            <option value="">Select a component</option>
                            <option value="frontend">Frontend</option>
                            <option value="backend">Backend</option>
                            <option value="database">Database</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Type</label>
                        <div class="radio-group">
                            <label>
                                <input type="radio" name="type" value="UI" class="radio-input"> UI
                            </label>
                            <label>
                                <input type="radio" name="type" value="Non-UI" class="radio-input"> Non-UI
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="newAssignee">New Assignee</label>
                        <input type="text" class="input-field" id="newAssignee" placeholder="Enter new assignee">
                    </div>
                    <button type="submit" class="submit-button">Submit</button>
                </form>
            </div>
        </div>
    </template>

    <script src="script.js"></script>
</body>
</html>


