document.addEventListener("DOMContentLoaded", () => {
    const bugs = [
        { id: '1', title: 'Login page not responsive', assignee: 'John Doe', createdDate: '2023-05-15', raisedByDirector: true, resolved: false },
        { id: '2', title: 'Button color inconsistent', assignee: 'Jane Smith', createdDate: '2023-05-16', raisedByDirector: false, resolved: false },
        { id: '3', title: 'Form validation error', assignee: 'Bob Johnson', createdDate: '2023-05-17', raisedByDirector: false, resolved: false },
    ];

    const bugList = document.getElementById("bug-list");
    const previewButton = document.getElementById("preview-button");

    bugs.forEach(bug => {
        const bugCardTemplate = document.getElementById("bug-card-template");
        const bugCard = bugCardTemplate.content.cloneNode(true);
        const bugCardElement = bugCard.querySelector(".bug-card");

        if (bug.raisedByDirector) {
            bugCardElement.classList.add("raised-by-director");
        }

        bugCardElement.querySelector(".bug-title").textContent = bug.title;
        bugCardElement.querySelector(".bug-id").textContent = `ID: ${bug.id}`;
        bugCardElement.querySelector(".bug-assignee").textContent = `Assignee: ${bug.assignee}`;
        bugCardElement.querySelector(".bug-created-date").textContent = `Created: ${bug.createdDate}`;

        const bugDetails = bugCardElement.querySelector(".bug-card-details");

        bugCardElement.addEventListener("click", () => {
            bugDetails.style.display = (bugDetails.style.display === "none" || bugDetails.style.display === "") ? "block" : "none";
        });

        const form = bugCardElement.querySelector(".bug-card-form");
        form.addEventListener("submit", (e) => {
            e.preventDefault();
            console.log({
                comment: form.querySelector("#comment").value,
                component: form.querySelector("#component").value,
                type: form.querySelector("input[name='type']:checked")?.value,
                newAssignee: form.querySelector("#newAssignee").value
            });
            bugList.removeChild(bugCardElement);
            previewButton.style.display = "block"; // Show the preview button
        });

        bugList.appendChild(bugCardElement);
    });

    previewButton.addEventListener("click", () => {
        alert("Preview clicked!");
    });
});
